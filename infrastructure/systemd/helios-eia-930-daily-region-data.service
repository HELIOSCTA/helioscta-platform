[Unit]
Description=HeliosCTA EIA-930 daily region data orchestration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-eia-930-daily-region-data.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.eia.eia_930_daily_region_data
TimeoutStartSec=5h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-eia-930-daily-region-data

[Install]
WantedBy=multi-user.target
