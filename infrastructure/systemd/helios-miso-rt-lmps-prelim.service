[Unit]
Description=HeliosCTA MISO Preliminary Real-Time Hourly LMP orchestration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-miso-rt-lmps-prelim.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.power.miso.rt_lmps_prelim
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-miso-rt-lmps-prelim

[Install]
WantedBy=multi-user.target
