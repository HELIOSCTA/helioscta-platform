[Unit]
Description=HeliosCTA PJM real-time marginal value orchestration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-pjm-rt-marginal-value.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.power.pjm.rt_marginal_value
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-pjm-rt-marginal-value

[Install]
WantedBy=multi-user.target
