[Unit]
Description=HeliosCTA NYISO Day-Ahead Hourly LBMP orchestration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-nyiso-da-lmps.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.power.nyiso.da_lmps
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-nyiso-da-lmps

[Install]
WantedBy=multi-user.target
