[Unit]
Description=HeliosCTA ERCOT Meteologica hourly forecast refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-ercot-meteologica-forecast-hourly.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.power.ercot.meteologica_forecast_hourly
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-ercot-meteologica-forecast-hourly

[Install]
WantedBy=multi-user.target
