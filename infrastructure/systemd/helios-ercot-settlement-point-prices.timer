[Unit]
Description=Overnight HeliosCTA ERCOT Real-Time Settlement Point Prices orchestration timer

[Timer]
OnCalendar=*-*-* 00:15:00 America/Chicago
OnCalendar=*-*-* 01:15:00 America/Chicago
OnCalendar=*-*-* 02:15:00 America/Chicago
OnCalendar=*-*-* 03:15:00 America/Chicago
Persistent=false
RandomizedDelaySec=2min
AccuracySec=30s
Unit=helios-ercot-settlement-point-prices.service

[Install]
WantedBy=timers.target
