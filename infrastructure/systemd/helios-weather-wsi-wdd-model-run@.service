[Unit]
Description=HeliosCTA WSI WDD model-run poller %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-weather-wsi-wdd-model-run-%i.lock /opt/helioscta-platform/.venv/bin/python -c "from backend.orchestration.weather.wsi.daily_weighted_forecasts import run_degree_day_model_run_instance; run_degree_day_model_run_instance('%i')"
TimeoutStartSec=150min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-weather-wsi-wdd-model-run

[Install]
WantedBy=multi-user.target
