[Unit]
Description=Daily HeliosCTA MISO Preliminary Real-Time Hourly LMP orchestration timer

[Timer]
OnCalendar=*-*-* 09:15:00 UTC
OnCalendar=*-*-* 13:15:00 UTC
OnCalendar=*-*-* 17:15:00 UTC
Persistent=true
RandomizedDelaySec=2min
AccuracySec=1min
Unit=helios-miso-rt-lmps-prelim.service

[Install]
WantedBy=timers.target
