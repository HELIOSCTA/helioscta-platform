[Unit]
Description=Overnight HeliosCTA CAISO Real-Time Five-Minute LMP orchestration timer

[Timer]
OnCalendar=*-*-* 00:15:00 America/Los_Angeles
OnCalendar=*-*-* 01:15:00 America/Los_Angeles
OnCalendar=*-*-* 02:15:00 America/Los_Angeles
OnCalendar=*-*-* 03:15:00 America/Los_Angeles
Persistent=false
RandomizedDelaySec=5min
AccuracySec=1min
Unit=helios-caiso-rt-lmps.service

[Install]
WantedBy=timers.target
