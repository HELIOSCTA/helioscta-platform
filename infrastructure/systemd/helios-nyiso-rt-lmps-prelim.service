[Unit]
Description=HeliosCTA NYISO Preliminary Real-Time Five-Minute LBMP orchestration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=helios
Group=helios
WorkingDirectory=/opt/helioscta-platform
EnvironmentFile=/etc/helioscta/backend.env
ExecStart=/usr/bin/flock -n /tmp/helios-nyiso-rt-lmps-prelim.lock /opt/helioscta-platform/.venv/bin/python -m backend.orchestration.power.nyiso.rt_lmps_prelim
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios-nyiso-rt-lmps-prelim

[Install]
WantedBy=multi-user.target
