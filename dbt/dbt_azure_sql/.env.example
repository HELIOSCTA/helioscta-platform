# Azure SQL dbt credentials for GenscapeDataFeed.
# Copy to `.env` in this directory and fill in values locally.
# Use a principal allowed to create/replace views in `salts` for `dbt run`.

AZURE_SQL_SERVER=heliosazuresql.database.windows.net
AZURE_SQL_DATABASE=GenscapeDataFeed
AZURE_SQL_PORT=1433
AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
